---
import { Code } from 'astro:components';

interface Props {
  after: string;
  afterLabel?: string;
  before?: string;
  beforeLabel?: string;
}

const { after, afterLabel = 'The modern coding style', before, beforeLabel = 'Before' } = Astro.props;
---

<div class:list={['pair', { single: !before }]}>
  {
    before && (
      <figure class="side before">
        <figcaption>✗ {beforeLabel}</figcaption>
        <Code code={before.trimEnd()} lang="js" theme="github-dark-default" />
      </figure>
    )
  }
  <figure class="side after">
    <figcaption>✓ {afterLabel}</figcaption>
    <Code code={after.trimEnd()} lang="js" theme="github-dark-default" />
  </figure>
</div>

<style>
  .pair {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin: 1.25rem 0 2rem;
  }

  @media (min-width: 960px) {
    .pair:not(.single) {
      grid-template-columns: 1fr 1fr;
    }
  }

  figure {
    margin: 0;
    min-width: 0;
  }

  figcaption {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
  }

  .before figcaption {
    color: #f87171;
  }

  .after figcaption {
    color: #4ade80;
  }

  figure :global(pre) {
    background: var(--code-bg) !important;
    font-size: 0.82rem;
    height: calc(100% - 1.6rem);
    margin: 0;
  }

  .before :global(pre) {
    border-color: #4b2a2a;
  }

  .after :global(pre) {
    border-color: #1f4730;
  }
</style>
